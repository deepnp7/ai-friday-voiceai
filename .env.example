# ============================================================
# Adaptive Cognitive Voice Assistant Platform — Environment
# ============================================================
# Copy this file to .env and fill in your values

# --- LLM (at least one required) ---
GOOGLE_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here        # optional fallback

# --- LLM Provider: "gemini" | "openai" ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# --- Speech (optional — browser Web Speech API used by default) ---
ELEVENLABS_API_KEY=                             # optional TTS upgrade
DEEPGRAM_API_KEY=                              # optional STT upgrade
AZURE_SPEECH_KEY=                              # optional Azure Speech
AZURE_SPEECH_REGION=eastus

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-random-256-bit-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/voice_assistant.db

# --- Redis (optional — in-memory fallback used if not set) ---
REDIS_URL=redis://localhost:6379

# --- Vector DB (optional — mocked if not set) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_base

# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Analytics ---
ENABLE_ANALYTICS=true
